{
  "name": "startup-runner",
  "displayName": "Startup Runner",
  "description": "Runs script on start up workspace",
  "version": "0.3.0",
  "packageManager": "pnpm@10.27.0",
  "publisher": "708u",
  "license": "MIT",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/708u/vscode-startup-runner"
  },
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Startup Runner",
      "properties": {
        "startupRunner.tasks": {
          "type": "array",
          "scope": "resource",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Task name"
              },
              "file": {
                "type": "string",
                "description": "Trigger file path or glob pattern (e.g., '.startup/setup.sh', '*.sh')"
              },
              "enabled": {
                "type": "boolean",
                "description": "Enable this task"
              }
            },
            "required": [
              "name",
              "file",
              "enabled"
            ]
          },
          "default": [],
          "description": "List of tasks with trigger files. Duplicate tasks with the same name and file are ignored."
        },
        "startupRunner.worktree.shareApproval": {
          "type": "boolean",
          "scope": "application",
          "default": true,
          "description": "Share approval state across git worktrees. When enabled, approvals are stored using the base repository path."
        }
      }
    },
    "commands": [
      {
        "command": "startupRunner.resetApprovedFiles",
        "title": "Startup Runner: Reset Approved Files..."
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "vscode-test",
    "login": "vsce login startup-runner",
    "pack": "vsce package --no-dependencies",
    "publish": "vsce publish",
    "bump:patch": "pnpm version patch --no-git-tag-version",
    "bump:minor": "pnpm version minor --no-git-tag-version",
    "bump:major": "pnpm version major --no-git-tag-version"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/mocha": "10.0.10",
    "@types/node": "22.19.3",
    "@types/prismjs": "1.26.5",
    "@types/vscode": "1.107.0",
    "@vscode/test-cli": "0.0.12",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "3.7.1",
    "esbuild": "0.27.2",
    "npm-run-all": "4.1.5",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "prismjs": "1.30.0"
  }
}
